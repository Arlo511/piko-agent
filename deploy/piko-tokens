#!/bin/sh
# 课堂令牌管理（install.sh 装到服务器 /usr/local/bin/piko-tokens）。只能在服务器本机运行。
# 以服务用户 piko 运行 `web-server tokens`，这样令牌文件始终归服务所有；运行中的服务约 1 秒内生效。
#   sudo piko-tokens generate 30 --csv > tokens.csv
#   sudo piko-tokens list | revoke 学员03 | revoke-all | limit --all --daily 300000
#   sudo piko-tokens claims | reset-claim 论坛用户名   （自助领取记录）
#   sudo piko-tokens --help
set -eu
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
env_file=/etc/piko-web/env
value() { [ -f "$env_file" ] && sed -n "s/^$1=//p" "$env_file" | head -1; }
tokens="$(value PIKO_CLASS_TOKENS || true)"
tz="$(value PIKO_TZ || true)"
cd /
# The upstream key is not passed on: managing tokens does not need it.
if command -v runuser >/dev/null 2>&1; then run() { runuser -u piko -- "$@"; }; else run() { sudo -u piko -- "$@"; }; fi
run env -i PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 \
  PIKO_CLASS_TOKENS="${tokens:-/var/lib/piko-web/class-tokens.json}" PIKO_TZ="${tz:-Asia/Shanghai}" \
  JAVA_OPTS="-Xmx128m -XX:+UseSerialGC -Dfile.encoding=UTF-8" \
  /opt/piko-web/current/bin/web-server tokens "$@"
